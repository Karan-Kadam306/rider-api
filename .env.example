# Copy to .env and fill in your own values. .env is git-ignored.

# Port the Express API listens on.
PORT=3000

# Main database used by the app.
DATABASE_URL=postgres://postgres:your_password@localhost:5432/rider_db

# Test database used by `npm test`. Its name must end with _test:
# the tests empty every table before each test.
TEST_DATABASE_URL=postgres://postgres:your_password@localhost:5432/rider_test

# How long a sign-in lasts before the user must sign in again. Optional; default 12.
SESSION_TTL_HOURS=12

# Number of reverse proxies in front of the API (e.g. 1 behind nginx), so sign-in limits
# see the real client IP. Leave unset when clients connect to the API directly.
TRUST_PROXY=
