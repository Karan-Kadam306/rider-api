# Copy to .env and fill in your own values. .env is git-ignored.

# Port the Express API listens on.
PORT=3000

# Main database used by the app.
DATABASE_URL=postgres://postgres:your_password@localhost:5432/rider_db

# Test database used by `npm test`. Its name must end with _test:
# the tests empty every table before each test.
TEST_DATABASE_URL=postgres://postgres:your_password@localhost:5432/rider_test

# How long a sign-in lasts before the user must sign in again. Optional; default 12.
SESSION_TTL_HOURS=12

# Admin UI address, used to build the mock payment links riders open.
APP_URL=http://localhost:5173

# Shared secret the payment provider signs its webhooks with. Any long random string.
PAYMENT_WEBHOOK_SECRET=change_me

# Set to true to serve the mock rider payment page (/api/mock-pay). Keep it off in production.
ENABLE_MOCK_PAY=true

# Set to true to make the mock IoT lock and unlock fail, to try the Failed lock path.
MOCK_IOT_FAIL=false

# Number of reverse proxies in front of the API (e.g. 1 behind nginx), so sign-in limits
# see the real client IP. Leave unset when clients connect to the API directly.
TRUST_PROXY=

# Encrypts Aadhaar, PAN, DL and bank account numbers. 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never change it once data is stored: old values could no longer be read.
ID_ENCRYPTION_KEY=
# Name of that key, stored with each value so keys can be rotated later.
ID_ENCRYPTION_KEY_ID=k1

# Separate key for the hashes used to find duplicate ID and account numbers. Generate the same way.
ID_HASH_KEY=

# Folder for rider document photos and PDFs. Must be an absolute path outside this project.
UPLOAD_DIR=D:/rider-uploads

# Rider app sign-in. The mock SMS client prints codes in the API log.
# Set RIDER_OTP_IN_RESPONSE=true to also return the code in the API response while trying the app.
# It is ignored when NODE_ENV=production.
RIDER_OTP_IN_RESPONSE=false
# How long a rider app sign-in lasts without being used. Optional; default 30.
RIDER_SESSION_DAYS=30
